# Hola Server Configuration

# Server Settings
HOLA_HOST=0.0.0.0
HOLA_PORT=8000
HOLA_DEBUG=false

# Security
HOLA_API_KEY=your-secure-api-key-here
HOLA_SESSION_SECRET=your-session-secret-here
HOLA_ADMIN_PASSWORD=your-admin-password-here

# CORS Configuration
HOLA_CORS_ORIGINS=*

# Logging
HOLA_LOG_LEVEL=INFO

# Storage
HOLA_DATA_DIR=./data

# Docker Configuration
# HOLA_DOCKER_SOCKET=/var/run/docker.sock  # Auto-detected if not set
