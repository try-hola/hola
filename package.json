{
  "name": "hola",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "bun run --filter './packages/*' lint",
    "test": "bun run test:server && bun run test:web && bun run test:cli",
    "test:all": "bun run --filter './packages/*' test",
    "test:web": "cd packages/web && npx vitest run",
    "test:cli": "cd packages/cli && npx vitest run",
    "test:web:watch": "cd packages/web && npx vitest",
    "test:server": "bun --cwd packages/server test",
    "test:server:watch": "bun --cwd packages/server test --watch",
    "test:integration": "bun --cwd packages/server test:integration",
    "test:env:setup": "docker-compose -f packages/server/test-docker-compose.yml up -d",
    "test:env:teardown": "docker-compose -f packages/server/test-docker-compose.yml down -v",
    "test:env:integration": "bun run test:env:setup && sh -c 'bun run test:integration; rc=$?; bun run test:env:teardown; exit $rc'",
    "dev:web": "bun --cwd packages/web dev",
    "dev:server": "bun --cwd packages/server dev",
    "dev": "bunx --bun concurrently -n server,web -c blue,green \"bun --cwd packages/server dev\" \"bun --cwd packages/web dev\"",
    "clean": "git clean -fdX && git reset --hard",
    "ci:local": "act -W .github/workflows/ci-local.yml push",
    "ci:local:dryrun": "act -W .github/workflows/ci-local.yml push -n",
    "ci:local:full": "act push",
    "ci:local:pr": "act pull_request",
    "ci:local:list": "act --list"
  },
  "packageManager": "bun@1.3.14",
  "resolutions": {
    "@babel/core": "^7.29.7",
    "@babel/helpers": "7.29.7",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.0",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "postcss": "^8.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shell-quote": "1.8.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1"
  }
}
