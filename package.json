{
  "name": "hola",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/try-hola/hola.git",
  "author": "Paul O'Fallon <pofallon@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "test": "yarn workspaces run test",
    "test:coverage": "yarn workspaces run test:coverage",
    "lint": "yarn workspaces run lint",
    "lint:fix": "yarn workspaces run lint:fix",
    "format": "yarn workspaces run format",
    "prepare": "husky",
    "build": "tsc -b .",
    "build:server": "tsc -b packages/server",
    "build:client": "tsc -b packages/client",
    "watch": "tsc -b . --watch",
    "dev": "concurrently \"yarn workspace @hola/server dev\" \"yarn workspace @hola/cli build --watch\"",
    "clean": "tsc -b . --clean && yarn workspaces run clean"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write"
    ]
  }
}
