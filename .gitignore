# Dependencies
node_modules/
bun.lockb

# Local, machine-specific tooling artifacts (never commit)
.deacon/
.claude/settings.local.json

# Build outputs
dist/
build/
.out/
.next/
.vite/
.cache/
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
logs/
*.log

# Editor/OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.*
!.env.example

# Per-host CLI credentials written by `hola bootstrap` / `hola credentials`
hola-*.env

# MCP / disposable-VM testing secrets + local state (template is committed)
.devcontainer/mcp.env
.devcontainer/hola.env
.devcontainer/.vm-state
.devcontainer/.vm-keys/

# Monorepo packages
packages/*/dist
packages/*/.vite
packages/*/node_modules
packages/*/coverage

# Misc
*.local

# TypeScript build info
**/tsconfig.tsbuildinfo
.tsbuildinfo

# Bun compile scratch artifacts
*.bun-build

# Core dumps (e.g. from a crashed test worker)
core
core.*
# …but the bare `core` pattern also shadows the server's `services/core/` source
# directory (same name), silently ignoring NEW files added there. Re-include it.
!packages/server/src/services/core/
