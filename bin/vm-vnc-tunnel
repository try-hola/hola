#!/usr/bin/env bash
# bin/vm-vnc-tunnel — SSH-forward the VM's in-guest VNC port to the container,
# so the in-container `vnc` MCP server (@hrrrsn/mcp-vnc) can drive its desktop.
#
# Usage: bin/vm-vnc-tunnel [--vmid VMID] [--down] [--dry-run]
#
# Opens a background `ssh -L 127.0.0.1:$VNC_PORT -> VM:$VNC_REMOTE_PORT` using the
# ephemeral per-VM key. RFB never leaves the VM unencrypted and nothing is exposed
# publicly. The vnc MCP server connects to 127.0.0.1:$VNC_PORT (its defaults).
#
# Requires a VNC server running inside the guest (e.g. x11vnc / the desktop's
# built-in) on $VNC_REMOTE_PORT (default 5900).
set -euo pipefail
source "$(dirname "$0")/_common.sh"
load_env

DOWN=0
LOCAL_PORT="${VNC_PORT:-5900}"
REMOTE_PORT="${VNC_REMOTE_PORT:-5900}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --vmid) VM_ID=$2; shift 2 ;;
    --down) DOWN=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) grep -E '^# ' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown arg: $1" ;;
  esac
done

VMID=$(resolve_vmid)

# Tear down any existing tunnel for this VM (recorded by PID).
existing=$(state_get VNC_TUNNEL_PID)
if [[ "$DOWN" == "1" ]]; then
  if [[ -n "$existing" ]] && kill "$existing" 2>/dev/null; then
    log "closed VNC tunnel (pid $existing)."
  else
    log "no active VNC tunnel to close."
  fi
  state_set VNC_TUNNEL_PID ""
  audit "vm-vnc-tunnel down vmid=$VMID pid=${existing:-none}"
  exit 0
fi

USER_NAME="${VM_SSH_USER:-$(state_get VM_SSH_USER)}"
IP="${VM_SSH_HOST:-$(state_get VM_IP)}"
KEY=$(vm_key_path "$VMID")

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  log "DRY_RUN: ssh -fN -L 127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT $USER_NAME@${IP:-<ip>}"
  log "DRY_RUN: vnc MCP server would connect to 127.0.0.1:$LOCAL_PORT"
  exit 0
fi

[[ -z "$IP" ]] && die "no VM IP (run bin/vm-wait-ssh first)."
[[ -z "$USER_NAME" ]] && die "no SSH user."
[[ -f "$KEY" ]] || die "private key $KEY not found."

# Replace a stale tunnel before opening a new one.
[[ -n "$existing" ]] && kill "$existing" 2>/dev/null || true

ssh_opts "$KEY"
log "opening VNC tunnel: 127.0.0.1:$LOCAL_PORT -> $IP:$REMOTE_PORT"
ssh "${SSH_OPTS[@]}" -fN -L "127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" "$USER_NAME@$IP"
# Record the forwarding ssh PID so --down (and vm-destroy) can close it.
pid=$(pgrep -f "127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT.*$USER_NAME@$IP" | head -1 || true)
state_set VNC_TUNNEL_PID "${pid:-}"
audit "vm-vnc-tunnel up vmid=$VMID local=$LOCAL_PORT remote=$REMOTE_PORT pid=${pid:-?}"

log "VNC ready for the 'vnc' MCP server at 127.0.0.1:$LOCAL_PORT."
log "If the vnc server was spawned before this tunnel, reconnect it: claude → /mcp."
