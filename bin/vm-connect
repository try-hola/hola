#!/usr/bin/env bash
# bin/vm-connect — resolve and print the VNC endpoint for the current test VM,
# so the VNC MCP server (and you) can connect to its console.
#
# Usage: bin/vm-connect [--vmid VMID] [--wait] [--timeout SECONDS] [--dry-run]
#
# Prefers an explicit VNC_HOST/VNC_PORT from the env (e.g. a stable tunnel). If
# unset, it asks Proxmox to open a VNC proxy for the VM and reports where it is
# listening. Read-only against Proxmox; never exposes VNC publicly.
set -euo pipefail
source "$(dirname "$0")/_common.sh"
load_env

WAIT=0; TIMEOUT=${VM_BOOT_TIMEOUT:-180}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --vmid) VM_ID=$2; shift 2 ;;
    --wait) WAIT=1; shift ;;
    --timeout) TIMEOUT=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) grep -E '^# ' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown arg: $1" ;;
  esac
done

VMID=$(resolve_vmid)
NODE="${PROXMOX_NODE:-$(state_get VM_NODE)}"
require_vars PROXMOX_API_URL PROXMOX_TOKEN_ID PROXMOX_TOKEN_SECRET
[[ -z "$NODE" ]] && die "PROXMOX_NODE not set and no node in state."

# Optionally wait for the VM to report 'running' before handing back an endpoint.
if [[ "$WAIT" == "1" && "${DRY_RUN:-0}" != "1" ]]; then
  log "waiting up to ${TIMEOUT}s for VM $VMID to be running..."
  deadline=$(( $(date +%s) + TIMEOUT ))
  until [[ "$(proxmox_curl GET "/nodes/$NODE/qemu/$VMID/status/current" | jq -r '.data.status')" == "running" ]]; do
    [[ $(date +%s) -ge $deadline ]] && die "VM $VMID not running after ${TIMEOUT}s."
    sleep 5
  done
  log "VM $VMID is running."
fi

# Explicit endpoint (stable tunnel / pre-provisioned) wins.
if [[ -n "${VNC_HOST:-}" && -n "${VNC_PORT:-}" ]]; then
  log "VNC endpoint (from env): $VNC_HOST:$VNC_PORT"
else
  log "opening a Proxmox VNC proxy for VM $VMID..."
  audit "vm-connect vncproxy vmid=$VMID"
  resp=$(proxmox_curl POST "/nodes/$NODE/qemu/$VMID/vncproxy" \
           --data-urlencode "websocket=1" || true)
  # `.data.port?` tolerates the dry-run placeholder (a string, not an object).
  port=$(echo "$resp" | jq -r '.data.port? // empty' 2>/dev/null || true)
  VNC_HOST="${VNC_HOST:-$(echo "${PROXMOX_API_URL}" | sed -E 's#^https?://([^:/]+).*#\1#')}"
  VNC_PORT="${port:-${VNC_PORT:-}}"
  log "VNC proxy via node $NODE (host $VNC_HOST, port ${VNC_PORT:-unknown})."
  warn "Proxmox vncproxy is short-lived and ticket-gated; for repeatable runs use"
  warn "a stable VNC tunnel and set VNC_HOST/VNC_PORT in .devcontainer/mcp.env."
fi

cat >&2 <<EOF

Next: have Claude Code use the 'vnc' MCP server to connect to:
  host: ${VNC_HOST:-<set VNC_HOST>}
  port: ${VNC_PORT:-<set VNC_PORT>}
(The VNC MCP server reads these via VNC_MCP_URL / its own config; keep VNC on the
private network or tunnel — never public.)
EOF

[[ -n "${VNC_HOST:-}" ]] && state_set VNC_HOST "$VNC_HOST" || true
[[ -n "${VNC_PORT:-}" ]] && state_set VNC_PORT "$VNC_PORT" || true
exit 0
