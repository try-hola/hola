#!/usr/bin/env bash
# bin/vm-desktop-install — install a minimal XFCE desktop + Firefox + TigerVNC on
# a RUNNING headless VM, over SSH. The browser-stage alternative to a desktop
# template: it runs on a proven-booting headless clone (no build-time image
# surgery / virt-resize), after cloud-init has grown the disk.
#
# Usage: bin/vm-desktop-install [--vmid VMID] [--dry-run]
#
# TigerVNC is configured with NO auth on 127.0.0.1:5900 — it's only reachable
# through bin/vm-vnc-tunnel (localhost, SSH-encrypted), so the vnc MCP server
# connects with no password needed. Idempotent-ish; safe to re-run.
set -euo pipefail
source "$(dirname "$0")/_common.sh"
load_env

while [[ $# -gt 0 ]]; do
  case "$1" in
    --vmid) VM_ID=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) grep -E '^# ' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown arg: $1" ;;
  esac
done

VMID=$(resolve_vmid)

# The remote provisioning script (runs on the VM as the SSH user, with sudo).
read -r -d '' REMOTE <<'REMOTE_EOF' || true
set -eux
export DEBIAN_FRONTEND=noninteractive
# Wait for cloud-init to finish (its apt work + growpart disk resize) so we don't
# race it, and have apt wait for any lock (unattended-upgrades) instead of failing.
cloud-init status --wait || true
APT="sudo apt-get -o DPkg::Lock::Timeout=600"
$APT update
$APT install -y xfce4 xfce4-goodies dbus-x11 tigervnc-standalone-server curl

# Firefox from Mozilla's APT repo (Ubuntu's `firefox` is a snap; we want a .deb).
sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg | sudo tee /etc/apt/keyrings/packages.mozilla.org.asc >/dev/null
echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" | sudo tee /etc/apt/sources.list.d/mozilla.list >/dev/null
printf 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n' | sudo tee /etc/apt/preferences.d/mozilla >/dev/null
$APT update
$APT install -y firefox

# Per-user VNC session: XFCE via xstartup, no password (localhost-only via tunnel).
mkdir -p "$HOME/.vnc"
cat > "$HOME/.vnc/xstartup" <<'XS'
#!/bin/sh
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
exec startxfce4
XS
chmod 755 "$HOME/.vnc/xstartup"

# TigerVNC on :0 (port 5900), bound to localhost, no auth.
sudo tee /etc/systemd/system/hola-vnc.service >/dev/null <<SVC
[Unit]
Description=Hola test TigerVNC (:0 -> 127.0.0.1:5900)
After=network.target
[Service]
Type=simple
User=$USER
ExecStartPre=-/usr/bin/tigervncserver -kill :0
ExecStart=/usr/bin/tigervncserver -fg :0 -localhost yes -geometry 1280x800 -SecurityTypes None
Restart=on-failure
[Install]
WantedBy=multi-user.target
SVC
sudo systemctl daemon-reload
sudo systemctl enable --now hola-vnc.service
sleep 2
systemctl is-active hola-vnc && echo "DESKTOP_READY $(command -v firefox)"
REMOTE_EOF

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  log "DRY_RUN: would run the desktop install on VM $VMID over SSH (xfce + firefox + tigervnc, no-auth on 127.0.0.1:5900)"
  exit 0
fi

log "installing desktop on VM $VMID over SSH (this takes a few minutes)..."
audit "vm-desktop-install vmid=$VMID"
# Pipe the script to a remote login shell so $HOME/$USER resolve on the VM.
printf '%s\n' "$REMOTE" | "$BIN_DIR/vm-ssh" --vmid "$VMID" -- bash -s
log "desktop ready on VM $VMID. Next: bin/vm-vnc-tunnel --vmid $VMID"
