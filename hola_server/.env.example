# Server connection
HOLA_HOST=0.0.0.0
HOLA_PORT=8000
HOLA_DEBUG=false

# Security
HOLA_API_KEY=your-secure-api-key-here

# CORS settings
HOLA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
HOLA_LOG_LEVEL=INFO
HOLA_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Storage
HOLA_DATA_DIR=./data

# Docker integration
HOLA_DOCKER_SOCKET=unix:///var/run/docker.sock