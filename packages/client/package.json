{
  "name": "@hola/cli",
  "version": "0.1.0",
  "description": "Hola command-line client",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "hola": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --require ./test-register.js --test \"src/**/*.node.test.ts\" && jest --bail --testPathIgnorePatterns=\".node.test.ts$\"",
    "test:node": "node --require ./test-register.js --test \"src/**/*.node.test.ts\"",
    "test:jest": "jest --bail --testPathIgnorePatterns=\".node.test.ts$\"",
    "test:watch": "jest --watch",
    "test:node:watch": "node --require ./test-register.js --test --watch \"src/**/*.node.test.ts\"",
    "test:node:coverage": "node --require ./test-register.js --test --experimental-test-coverage \"src/**/*.node.test.ts\"",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "dev": "ts-node src/index.ts",
    "debug": "node --inspect-brk -r ts-node/register src/index.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "commander": "^9.4.0",
    "conf": "^10.2.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.5.2",
    "keytar": "^7.9.0",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "@types/node": "^18.15.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT"
}
