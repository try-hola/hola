AUTHENTIK_SECRET_KEY=${authSecretKey}
AUTHENTIK_BOOTSTRAP_PASSWORD=${options.authProvider.initialAdminPassword}
AUTHENTIK_BOOTSTRAP_TOKEN=${bootstrapToken}
