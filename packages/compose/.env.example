# Example environment for Hola docker compose stack
# Copy to .env and adjust values as needed

# Global
COMPOSE_PROJECT_NAME=hola

# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_DOMAIN=traefik.local.hola
LETSENCRYPT_EMAIL=admin@example.com

# Domains for services (used by Traefik routers)
WEB_DOMAIN=app.local.hola
SERVER_DOMAIN=api.local.hola

# TLS via Let's Encrypt is enabled by default on HTTPS routers.
# Use real domains resolvable on the internet for LE issuance.

# Paths (relative to this package directory)
DATA_DIR=./data
LOGS_DIR=./logs
