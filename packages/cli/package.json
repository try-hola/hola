{
  "name": "@hola/cli",
  "version": "0.6.28",
  "private": true,
  "type": "module",
  "bin": {
    "hola": "./bin/hola"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node --format=esm --sourcemap --splitting",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/core": "^1.4.1",
    "@clack/prompts": "^1.5.1",
    "@hola/sdk": "workspace:*",
    "@hola/shared": "workspace:*",
    "eventsource-parser": "^3.1.0",
    "picocolors": "^1.1.1",
    "sade": "^1.8.1",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
