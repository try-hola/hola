{
  "name": "@hola/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hola": "./bin/hola"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
  "build": "bun build src/index.tsx --outdir=dist --target=node --format=esm --sourcemap --external=react-devtools-core --splitting",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hola/sdk": "workspace:*",
    "@hola/shared": "workspace:*",
    "eventsource-parser": "^3.0.3",
    "ink": "^6.2.0",
    "react": "^19.1.1",
    "react-devtools-core": "^4.28.0",
    "sade": "^1.8.1",
    "undici": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.5.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.9.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vitest": "^3.2.4"
  }
}
