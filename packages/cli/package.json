{
  "name": "@hola/cli",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "bin": {
    "hola": "./bin/hola"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "build": "bun build src/index.tsx --outdir=dist --target=node --format=esm --sourcemap --external=react-devtools-core --splitting",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@hola/sdk": "workspace:*",
    "@hola/shared": "workspace:*",
    "eventsource-parser": "^3.1.0",
    "ink": "^7.0.6",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "sade": "^1.8.1",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
