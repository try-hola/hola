{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext"], // Removed DOM as it's not needed for Node.js server
    "target": "ES2020", // Sets the target ECMAScript version for the output.
    "module": "CommonJS", // Change from NodeNext to CommonJS
    "moduleDetection": "force", // Forces TypeScript to treat files as modules regardless of the file content.
    "jsx": "react-jsx", // Enables the new JSX transform in React.
    "allowJs": true, // Permits JavaScript files to be compiled.

    // Bundler mode
    "moduleResolution": "Node", // Use standard Node resolution
    "allowImportingTsExtensions": false, // Allows importing TypeScript files with their extensions.
    "verbatimModuleSyntax": false, // Preserves original module syntax in the output.
    "noEmit": false, // Prevents emitting output files.

    // Best practices
    "strict": true, // Enables all strict type-checking options.
    "skipLibCheck": true, // Skips type checking of all declaration files.
    "noFallthroughCasesInSwitch": true, // Disallows fall-through between switch cases.

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false, // Does not error on unused local variables.
    "noUnusedParameters": false, // Does not error on unused function parameters.
    "noPropertyAccessFromIndexSignature": false, // Allows property access from index signatures directly.
    
    // Additional options
    "esModuleInterop": true, // Enables interoperability between CommonJS and ES Modules.
    "allowSyntheticDefaultImports": true, // Allows default imports from modules with no default export.
    "outDir": "./dist", // Redirects output structure to the directory.
    "sourceMap": true, // Generates corresponding .map file.
    "declaration": true, // Generates corresponding .d.ts file.
    "removeComments": false, // Does not remove comments from output.
    "forceConsistentCasingInFileNames": true, // Disallows inconsistently-cased references to the same file.
    "resolveJsonModule": true, // Includes modules imported with .json extension.
    "rootDir": "src", // Specifies the root directory of input files.
    
    // Project references specific options
    "composite": true, // Enables project references
    "declarationMap": true, // Generates a source map for .d.ts files
    "incremental": true, // Enables incremental compilation
    "tsBuildInfoFile": "./dist/.tsbuildinfo" // Specifies the file to store incremental compilation information
  },
  "include": ["src/**/*"], // Specifies an array of filenames or patterns to include in the program.
  "exclude": ["node_modules", "dist", "**/*.test.ts"], // Specifies an array of filenames or patterns to exclude from the program.
  "references": [] // No references to other projects in the server package
}
