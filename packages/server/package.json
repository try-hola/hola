{
  "name": "@hola/server",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mkdirp": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "tar": "^7.4.3",
    "uuid": "^11.0.5",
    "yamljs": "^0.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/tar": "^6.1.13",
    "@types/yamljs": "^0.2.34",
    "nodemon": "^3.0.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "dev": "nodemon --watch src -e ts,js --exec ts-node src/server.ts",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run test:node && jest --bail",
    "test:node": "node --require ./test-register.js --test \"src/**/*.node.test.ts\"",
    "test:jest": "jest --bail",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "clean": "rm -rf dist"
  }
}
