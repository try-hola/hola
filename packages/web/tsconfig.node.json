{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Build/test tooling runs in Node. Name the types explicitly rather than
       relying on whatever @types/* happen to be hoisted into node_modules. */
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
