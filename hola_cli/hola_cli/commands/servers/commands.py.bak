"""Server commands group.

This module provides the server command group for managing server instances.
"""
import asyncio
from typing import Optional, List, Dict, Any
import typer
from rich.table import Table
from rich.console import Console

from hola_shared.models.providers import ServerStatus
from ...providers.instance_manager import get_instance_manager
from ...providers.providers import get_provider_registry, get_available_provider_types
from ...utils.formatting import format_output

app = typer.Typer(help="Manage server instances")
console = Console()


@app.command("list")
def list_servers():
    """List all registered server instances."""
    instance_manager = get_instance_manager()
    instances = instance_manager.get_instances()
    
    if not instances:
        format_output(
            "No server instances found. Use 'hola servers create' to create one.",
            style="info"
        )
        return
    
    table = Table(title="Server Instances")
    table.add_column("ID", style="cyan")
    table.add_column("Name", style="green")
    table.add_column("Provider", style="magenta")
    table.add_column("Status", style="yellow")
    table.add_column("Created At")
    
    for instance in instances:
        table.add_row(
            instance.id,
            instance.name,
            instance.provider_type,
            instance.status.value,
            instance.created_at,
        )
    
    console.print(table)


@app.command("providers")
def list_providers():
    """List available server providers."""
    async def _list_providers():
        provider_registry = get_provider_registry()
        available_providers = await provider_registry.get_available_providers()
        
        if not available_providers:
            format_output(
                "No server providers are available on this system.",
                style="warning"
            )
            return
        
        table = Table(title="Available Server Providers")
        table.add_column("Type", style="cyan")
        table.add_column("Name", style="green")
        
        for provider in available_providers:
            table.add_row(
                provider.type,
                provider.display_name,
            )
        
        console.print(table)
        
    asyncio.run(_list_providers())


@app.command("create")
def create_server(
    name: str = typer.Option(..., "--name", "-n", help="Name for the server"),
    provider: str = typer.Option(..., "--provider", "-p", help="Provider type to use"),
    port: int = typer.Option(8000, "--port", help="Port to expose"),
    image: str = typer.Option(
        "python:3.10-slim", "--image", help="Docker image to use"
    ),
    env_vars: List[str] = typer.Option(
        [], "--env", "-e", help="Environment variables in KEY=VALUE format"
    ),
):
    """Create a new server instance."""
    # Parse environment variables
    env = {}
    for env_var in env_vars:
        if "=" not in env_var:
            format_output(
                f"Invalid environment variable format: {env_var}. Use KEY=VALUE format.",
                style="error"
            )
            raise typer.Exit(1)
        key, value = env_var.split("=", 1)
        env[key] = value
    
    # Create instance options
    options = {
        "port": port,
        "image": image,
        "env": env,
    }
    
    # Create the instance
    async def _create_server():
        try:
            # Check if provider is available
            available_providers = await get_available_provider_types()
            if provider not in available_providers:
                format_output(
                    f"Provider '{provider}' is not available. "
                    f"Available providers: {', '.join(available_providers)}",
                    style="error"
                )
                raise typer.Exit(1)
            
            # Create the instance
            format_output(f"Creating server '{name}' with provider '{provider}'...", style="info")
            instance_manager = get_instance_manager()
            instance = await instance_manager.create_instance(provider, name, options)
            
            format_output(
                f"Server '{name}' created successfully with ID: {instance.id}",
                style="success"
            )
            format_output(
                f"Use 'hola servers start {instance.id}' to start the server.",
                style="info"
            )
            
        except Exception as e:
            format_output(
                f"Failed to create server: {str(e)}",
                style="error"
            )
            raise typer.Exit(1)
    
    asyncio.run(_create_server())


@app.command("start")
def start_server(
    instance_id: str = typer.Argument(..., help="ID of the server instance to start"),
):
    """Start a server instance."""
    async def _start_server():
        try:
            instance_manager = get_instance_manager()
            
            # Check if instance exists
            instance = instance_manager.get_instance(instance_id)
            if not instance:
                format_output(
                    f"Server instance with ID '{instance_id}' not found.",
                    style="error"
                )
                raise typer.Exit(1)
            
            format_output(
                f"Starting server '{instance.name}' ({instance_id})...",
                style="info"
            )
            
            # Start the instance
            updated_instance = await instance_manager.start_instance(instance_id)
            
            if updated_instance.status == ServerStatus.RUNNING:
                format_output(
                    f"Server '{instance.name}' started successfully.",
                    style="success"
                )
            else:
                format_output(
                    f"Server status after start attempt: {updated_instance.status.value}",
                    style="warning"
                )
                if updated_instance.error:
                    format_output(f"Error: {updated_instance.error}", style="error")
                
        except Exception as e:
            format_output(
                f"Failed to start server: {str(e)}",
                style="error"
            )
            raise typer.Exit(1)
    
    asyncio.run(_start_server())


@app.command("stop")
def stop_server(
    instance_id: str = typer.Argument(..., help="ID of the server instance to stop"),
):
    """Stop a server instance."""
    async def _stop_server():
        try:
            instance_manager = get_instance_manager()
            
            # Check if instance exists
            instance = instance_manager.get_instance(instance_id)
            if not instance:
                format_output(
                    f"Server instance with ID '{instance_id}' not found.",
                    style="error"
                )
                raise typer.Exit(1)
            
            format_output(
                f"Stopping server '{instance.name}' ({instance_id})...",
                style="info"
            )
            
            # Stop the instance
            updated_instance = await instance_manager.stop_server(instance_id)
            
            if updated_instance.status == ServerStatus.STOPPED:
                format_output(
                    f"Server '{instance.name}' stopped successfully.",
                    style="success"
                )
            else:
                format_output(
                    f"Server status after stop attempt: {updated_instance.status.value}",
                    style="warning"
                )
                if updated_instance.error:
                    format_output(f"Error: {updated_instance.error}", style="error")
                
        except Exception as e:
            format_output(
                f"Failed to stop server: {str(e)}",
                style="error"
            )
            raise typer.Exit(1)
    
    asyncio.run(_stop_server())


@app.command("info")
def server_info(
    instance_id: str = typer.Argument(..., help="ID of the server instance"),
):
    """Get detailed information about a server instance."""
    async def _server_info():
        try:
            instance_manager = get_instance_manager()
            
            # Check if instance exists
            instance = instance_manager.get_instance(instance_id)
            if not instance:
                format_output(
                    f"Server instance with ID '{instance_id}' not found.",
                    style="error"
                )
                raise typer.Exit(1)
            
            # Refresh instance info
            updated_instance = await instance_manager.refresh_instance(instance_id)
            
            # Display info
            console.print(f"[bold cyan]Server Information:[/]")
            console.print(f"  [bold]ID:[/] {updated_instance.id}")
            console.print(f"  [bold]Name:[/] {updated_instance.name}")
            console.print(f"  [bold]Provider:[/] {updated_instance.provider_type}")
            console.print(f"  [bold]Status:[/] {updated_instance.status.value}")
            console.print(f"  [bold]Created At:[/] {updated_instance.created_at}")
            
            if updated_instance.started_at:
                console.print(f"  [bold]Started At:[/] {updated_instance.started_at}")
            
            if updated_instance.url:
                console.print(f"  [bold]URL:[/] {updated_instance.url}")
            
            if updated_instance.error:
                console.print(f"  [bold red]Error:[/] {updated_instance.error}")
            
            # Display context info
            console.print("\n[bold cyan]Provider Context:[/]")
            for key, value in updated_instance.context.items():
                if key != "provider" and key != "error":
                    console.print(f"  [bold]{key}:[/] {value}")
                
        except Exception as e:
            format_output(
                f"Failed to get server info: {str(e)}",
                style="error"
            )
            raise typer.Exit(1)
    
    asyncio.run(_server_info())


@app.command("delete")
def delete_server(
    instance_id: str = typer.Argument(..., help="ID of the server instance to delete"),
    force: bool = typer.Option(
        False, "--force", "-f", help="Delete without confirmation"
    ),
):
    """Delete a server instance (record only, does not stop or remove the server)."""
    instance_manager = get_instance_manager()
    
    # Check if instance exists
    instance = instance_manager.get_instance(instance_id)
    if not instance:
        format_output(
            f"Server instance with ID '{instance_id}' not found.",
            style="error"
        )
        raise typer.Exit(1)
    
    # Confirm deletion
    if not force:
        confirm = typer.confirm(
            f"Are you sure you want to delete server '{instance.name}' ({instance_id})? "
            f"This will only delete the record, not stop or remove the actual server."
        )
        if not confirm:
            format_output("Deletion cancelled.", style="info")
            return
    
    # Delete the instance
    success = instance_manager.delete_instance(instance_id)
    
    if success:
        format_output(
            f"Server record for '{instance.name}' deleted successfully.",
            style="success"
        )
    else:
        format_output(
            f"Failed to delete server record.",
            style="error"
        )
        raise typer.Exit(1)
