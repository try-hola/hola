{
  "name": "Node.js Project",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:latest",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "ms-vscode.vscode-typescript-next",
        "mikestead.dotenv",
        "christian-kohler.path-intellisense",
        "orta.vscode-jest",
        "github.copilot",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "jest.runMode": "on-save"
      }
    }
  },
  "forwardPorts": [
    3000
  ],
  "postCreateCommand": "./devcontainer/config.sh && yarn install",
  "mounts": [
    "source=${localEnv:HOME}/.config,target=/home/node/.config,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.dotfiles,target=/home/node/.dotfiles,type=bind,consistency=cached"
  ],
  "remoteUser": "node",
  "containerEnv": {
    "NODE_ENV": "development"
  }
}