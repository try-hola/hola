# ---------------------------------------------------------------------------
# MCP / disposable-VM testing environment (TEMPLATE — safe to commit)
#
# Copy to .devcontainer/mcp.env and fill in real values. mcp.env is gitignored
# and is loaded by bin/mcp-setup and the bin/vm-* helpers. NEVER commit secrets.
#
# Alternatively, export these on the HOST shell; the devcontainer forwards them
# into the container via `containerEnv` in devcontainer.json (localEnv passthru).
# ---------------------------------------------------------------------------

# --- proxmox MCP server (OPTIONAL — consumed by .mcp.json) -------------------
# The bin/vm-* helpers already drive the VM lifecycle via the Proxmox REST API,
# so the proxmox MCP server is optional. If you run one, point Claude at it here
# (streamable-HTTP). Leave blank to skip it.
PROXMOX_MCP_URL=
PROXMOX_MCP_TOKEN=

# --- vnc MCP server (runs IN-CONTAINER — consumed by .mcp.json) --------------
# .mcp.json launches @hrrrsn/mcp-vnc as a local stdio subprocess (via npx); no
# separate service to host. It connects to a VNC endpoint at VNC_HOST:VNC_PORT,
# which bin/vm-vnc-tunnel forwards to the VM's in-guest VNC server over SSH.
# Defaults below match the tunnel; normally you only set VNC_PASSWORD.
VNC_HOST=127.0.0.1
VNC_PORT=5900
# Port the VNC server listens on INSIDE the guest (x11vnc / desktop built-in).
VNC_REMOTE_PORT=5900
# Password of that in-guest VNC server (required by the vnc MCP server).
VNC_PASSWORD=

# --- Proxmox API (consumed by bin/vm-* helper scripts) -----------------------
# The helper scripts talk to the Proxmox REST API directly so the VM lifecycle
# is scriptable/CI-able independently of Claude. Use a LEAST-PRIVILEGE API token
# (Datacenter > Permissions > API Tokens), NOT a root password.
PROXMOX_API_URL=https://pve.mgmt.example.internal:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=hola-ci@pve!disposable-vm
PROXMOX_TOKEN_SECRET=
# Path to the Proxmox CA cert for TLS verification (preferred over disabling it).
PROXMOX_CACERT=
# Set to 1 ONLY for a lab with a self-signed cert you cannot pin. Logs a warning.
PROXMOX_TLS_INSECURE=0

# --- Disposable VM template / placement --------------------------------------
# VMID of the base template to clone. Build it once on the Proxmox host with
# bin/proxmox-build-template (cloud-init + guest agent + docker + the SSH user).
# The new VMID is auto-allocated via /cluster/nextid unless you pin VM_ID.
VM_TEMPLATE_ID=9000
VM_NAME_PREFIX=hola-test
VM_ID=
# Linked clone (fast, default) vs full clone. Storage for a full clone.
VM_FULL_CLONE=0
VM_STORAGE=
# Seconds bin/vm-test waits for the guest agent / VNC to come up before failing.
VM_BOOT_TIMEOUT=180

# --- SSH into the VM (consumed by bin/vm-ssh / bin/vm-wait-ssh) --------------
# For setup, installs, and headless/non-GUI tests — no VNC needed. vm-create
# generates an EPHEMERAL per-VM keypair and injects the public key via cloud-init
# (requires a cloud-init-enabled template with the QEMU guest agent). Must match
# the template's baked user (proxmox-build-template --user). Blank disables SSH.
VM_SSH_USER=hola
# Optional: pin a static cloud-init network instead of DHCP, e.g.
#   VM_IPCONFIG0=ip=10.10.0.50/24,gw=10.10.0.1
# A static IP pairs with a creds-free sslip.io domain for the Hola config:
#   HOLA_BASE_DOMAIN=10.10.0.50.sslip.io  (*.<ip>.sslip.io resolves to the IP).
# See "DNS & TLS" in docs/MCP_VM_TESTING.md. Leave ACME_DNS_PROVIDER unset so no
# AWS/DNS-provider creds are ever written to hola.env.
VM_IPCONFIG0=
# Optional overrides (normally auto-managed): a fixed host/IP to SSH to, or an
# existing private key instead of the per-VM ephemeral one.
VM_SSH_HOST=
VM_SSH_KEY=

# --- hola CLI bootstrap config (consumed by the vm-e2e skill) ----------------
# `hola bootstrap --host <alias>` installs Hola on the VM. Headlessly it needs a
# pre-rendered Hola .env passed via --env-file (the interactive wizard can't run
# without a TTY). This is a SEPARATE file from mcp.env — a real Hola config.
# Generate it once (interactively) with:
#   hola init --out .devcontainer/hola.env
# then the skill runs:  hola bootstrap --host <alias> --env-file .devcontainer/hola.env
# .devcontainer/hola.env is gitignored. Path is overridable here:
HOLA_ENV_FILE=.devcontainer/hola.env
